{
    "EventBus": {
        "BootstrapServers": "kafka:29092",
        "Topic": "email-topic",
        "GroupId": "email-group",
        "ClientId": "fc_messaging_emailservice"
    },
    "Smtp": {
        "From": "",
        "Host": "smtp.gmail.com",
        "Port": 587,
        "Username": "",
        "Password": "",
        "EnableSsl": true
    },
    "Serilog": {
        "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Seq" ],
        "MinimumLevel": {
            "Default": "Debug",
            "Override": {
                "Microsoft": "Warning",
                "System": "Warning",
                "Microsoft.Hosting.Lifetime": "Information"
            }
        },
        "Enrich": [
            "FromLogContext",
            "WithMachineName",
            "WithThreadId",
            {
                "Name": "WithCorrelationId"
            },
            {
                "Name": "WithProperty",
                "Args": {
                    "name": "Application",
                    "value": "FC.Messaging.EmailService"
                }
            },
            {
                "Name": "WithProperty",
                "Args": {
                    "name": "Environment",
                    "value": "Development"
                }
            }
        ],
        "WriteTo": [
            { "Name": "Console" },
            {
                "Name": "Seq",
                "Args": {
                    "serverUrl": "http://seq:5341"
                }
            }
        ]
    }
}