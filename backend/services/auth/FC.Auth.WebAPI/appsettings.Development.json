{
    "Application": {
        "UrlBase": "http://localhost:8080"
    },
    "ConnectionStrings": {
        "DefaultConnection": "Host=fc_auth_postgres;Port=5432;Database=DBSAuth_Dev;Username=db@user;Password=db@password;"
    },
    "Jwt": {
        "SecretKey": "YourSuperSecretKeyForJwtTokenGenerationThatShouldBeAtLeast32BytesLong",
        "EmailConfirmationSecret": "YourSuperSecretKeyForJwtTokenGenerationThatShouldBeAtLeast32BytesLong"
    },
    "EventBus": {
        "BootstrapServers": "kafka:29092",
        "ClientId": "fc_auth"
    },
    "Serilog": {
        "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Seq" ],
        "MinimumLevel": {
            "Default": "Debug",
            "Override": {
                "Microsoft": "Warning",
                "System": "Warning",
                "Microsoft.Hosting.Lifetime": "Information"
            }
        },
        "Enrich": [
            "FromLogContext",
            "WithMachineName",
            "WithThreadId",
            {
                "Name": "WithCorrelationId"
            },
            {
                "Name": "WithProperty",
                "Args": {
                    "name": "Application",
                    "value": "FC.Auth.WebAPI"
                }
            },
            {
                "Name": "WithProperty",
                "Args": {
                    "name": "Environment",
                    "value": "Development"
                }
            }
        ],
        "WriteTo": [
            { "Name": "Console" },
            {
                "Name": "Seq",
                "Args": {
                    "serverUrl": "http://seq:5341"
                }
            }
        ]
    }
}
